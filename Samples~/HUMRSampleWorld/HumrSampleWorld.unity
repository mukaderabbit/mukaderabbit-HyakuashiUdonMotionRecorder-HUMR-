      m_Calls: []
  m_text: '<b><size=50><align=center>Hyakuashi Udon Motion Recorder</size></b></align>


    HUMR
    is a motion capture tool that records player''s movements into the VRChat log
    files and then reads them in a Unity project. This is version 2, which uses a
    new log format.


'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
